        { type:"regex",  from:"^/saibanin/melmaga(?:/.*)?$", to:"/saibanin/shiryo/archive/melmaga/", preserve:{ query:false, hash:false  } },
        { type:"regex",  from:"^/saibanin(?:/.*)?$", to:"/saibanin/", preserve:{ query:false, hash:false  } },
        
    ];
    

    const u = new URL(location.href);
    const path = u.pathname;

    function ensureSingleSlash(a, b) {
        return (a.replace(/\/+$/, '') + '/' + b.replace(/^\/+/, ''));
    }

    function buildTarget(toPath, preserve) {
        // 絶対URLならそのまま
        if (/^https?:\/\//i.test(toPath)) return toPath;

        const q = preserve.query ? u.search : '';
        const h = preserve.hash  ? u.hash   : '';
        // 相対（ルート始まり）を想定
        return toPath + q + h;
    }

    for (let r of rules) {
        const preserve = Object.assign({}, defaultPreserve, r.preserve || {});
        let toPath = null;

        if (r.type === 'exact') {
          if (path === r.from) toPath = r.to;

        } 
        else if (r.type === 'prefix') {
          if (path.startsWith(r.from)) {
              const rest = path.slice(r.from.length);
              // /legacy/aaa → /new/aaa
              toPath = r.to.endsWith('/') ? ensureSingleSlash(r.to, rest) : (r.to + rest);
          }
        } else if (r.type === 'regex') {
          const re = new RegExp(r.from);
          if (re.test(path)) {
              toPath = path.replace(re, r.to);
          }
        }

        if (typeof toPath === "function") toPath = toPath(u);
        
        if (toPath) {
          const target = buildTarget(toPath, preserve);
          // ループ防止（同一URLなら無視）
          

          console.log(path, target);
          

          
          location.replace(target);
          return; 
        }
    }

    // マッチしなければ通常の404ページを表示
    document.documentElement.style.visibility = 'visible';
    })();
