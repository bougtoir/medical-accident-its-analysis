        { type:"regex",  from:"^/saibanin/access(?:/.*)?$", to:"/saibanin/kouhosha/access/index.html", preserve:{ query:false, hash:false  } },
        { type:"regex",  from:"^/saibanin/shiryo(?:/.*)?$", to:"/saibanin/shiryo/index.html", preserve:{ query:false, hash:false  } },
        { type:"regex",  from:"^/saibanin/videopamph(?:/.*)?$", to:"/saibanin/videopamph/index.html", preserve:{ query:false, hash:false  } },
